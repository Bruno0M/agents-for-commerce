# Copie para .env e preencha. Todas as variáveis são obrigatórias —
# o servidor falha no boot se qualquer uma estiver vazia (Program.cs:RequireConfig).

# Token que os clientes MCP mandam em `Authorization: Bearer <token>`.
MCP_BEARER_TOKEN=

# AI Gateway da org na Deco Studio.
AI_GATEWAY_ORG_SLUG=
AI_GATEWAY_API_KEY=

# Modelo usado pelas tools de geração de conteúdo (05) e simulação de comprador (06),
# no formato "provider/model" do AI Gateway. Opcional — default "anthropic/claude-sonnet-5".
AI_GATEWAY_MODEL=

# API key da org bruno-feijoada usada pela tool de publicação (07) para chamar de volta
# o MCP de management da própria Studio (mcp/self) e criar itens no Task Board.
# Gerada via API_KEY_CREATE com permissão mínima {"self": ["TASK_BOARD_ITEM_CREATE"]} —
# diferente da AI_GATEWAY_API_KEY acima, que não tem essa permissão.
STUDIO_API_KEY=

# Aceita o nome da loja ("afc-store-xxxx") ou o domínio *.myshopify.com completo.
SHOPIFY_STORE_DOMAIN=

# App do Dev Dashboard (dev.shopify.com) → Settings → Credentials. Não existe mais
# token permanente: o servidor troca esse par por um token de 24h e renova sozinho.
# O app precisa estar instalado na loja e declarar os escopos read_products/read_inventory.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
