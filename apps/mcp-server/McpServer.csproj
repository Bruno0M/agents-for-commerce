<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="ShopifySharp" Version="6.28.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="McpServer.Tests/**" />
    <Content Remove="McpServer.Tests/**" />
    <None Remove="McpServer.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ticket 04 (issue #7): the apps/web single-file build, embedded in the
         assembly so it's served identically from `dotnet run` and a publish
         output — no loose file, no relative path that could point somewhere
         else after publish. Regenerated by scripts/build-web-bundle.sh; see
         the README for when to run it. -->
    <EmbeddedResource Include="Resources/web-app.html">
      <LogicalName>McpServer.Resources.web-app.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McpServer.Tests" />
  </ItemGroup>

</Project>
