# Qual transporte o /web usa FORA do Studio (dentro dele é sempre o bridge,
# e estas variáveis são ignoradas):
#
#   fixture (default) — loja de exemplo, exame mockado, nada de servidor.
#                       É o modo em que as telas se desenvolvem, e o único
#                       que funciona com o mcp-server fora do ar.
#   fetch             — catálogo lido do mcp-server (GET /catalog). O exame
#                       NÃO roda: generate_test_orders e simulate_buyer_agent
#                       gastam crédito de LLM e não têm rota sem auth. A tela
#                       diz isso quando o botão é clicado.
VITE_EXAM_TRANSPORT=fixture

# Base URL de apps/mcp-server, usada só pelo transporte `fetch`.
# Default: http://localhost:6142 (o `dotnet run`).
VITE_MCP_SERVER_URL=http://localhost:6142
